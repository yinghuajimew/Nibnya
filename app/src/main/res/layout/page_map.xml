<?xml version="1.0" encoding="utf-8"?>
<!--
  「地图」页 —— 只读地形预览（2026-11-02）。

  设计要点（按用户反馈调整）：
    1. **不再单独选世界** —— 直接用主页当前打开的世界，
       切到地图页自动开始加载，不需要再点一次。
    2. **没有「生成地形」按钮** —— 进页面就渲染，换世界自动重渲染。
    3. **范围用下拉选择**，不是点一下循环。可以选预设或自定义。

  布局：
    顶部：世界名 + 范围选择器
    中间：MapView
    底部：状态
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_map"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg"
    android:visibility="gone">

    <!-- ── 工具条 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/app_surface">

        <TextView
            android:id="@+id/tv_map_world"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_no_world"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <!-- 范围选择：点击弹出下拉，而不是循环 -->
        <TextView
            android:id="@+id/tv_map_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/map_radius_auto"
            android:textColor="@color/c_link_lang"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ▾"
            android:textColor="@color/c_link_lang"
            android:textSize="11sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_divider" />

    <!-- ── 地形图 ── -->
    <yhjmew.nibnya.map.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── 状态行 ── -->
    <TextView
        android:id="@+id/tv_map_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="@string/map_status_waiting_world"
        android:textColor="@color/app_text_secondary"
        android:textSize="12sp"
        android:background="@color/app_surface" />

</LinearLayout>

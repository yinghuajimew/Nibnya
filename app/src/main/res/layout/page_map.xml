<?xml version="1.0" encoding="utf-8"?>
<!--
  「地图」页 —— 只读地形预览（2026-11-02 起从占位页换成真实视图）。

  布局分三层：
    1. 顶部工具条：世界选择 + 渲染按钮 + 半径
    2. 中间：MapView（自绘，可拖可缩）
    3. 底部：状态/进度文字

  顶部不遮挡地图，所以用纵向 LinearLayout 而不是浮层，
  这样小屏也不会挡住地形。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_map"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg"
    android:visibility="gone">

    <!-- ── 工具条 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="@color/app_surface">

        <TextView
            android:id="@+id/tv_map_world"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_no_world"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:paddingTop="4dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_map_pick_world"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:text="@string/map_pick_world"
                android:textAllCaps="false"
                android:textColor="@color/c_link_lang"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_map_render"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:text="@string/map_render"
                android:textAllCaps="false"
                android:textColor="@color/c_icon_view"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_map_radius"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:text="@string/map_radius_default"
                android:textAllCaps="false"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_divider" />

    <!-- ── 地形图 ── -->
    <yhjmew.nibnya.map.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── 状态行 ── -->
    <TextView
        android:id="@+id/tv_map_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="@string/map_status_idle"
        android:textColor="@color/app_text_secondary"
        android:textSize="12sp"
        android:background="@color/app_surface" />

</LinearLayout>

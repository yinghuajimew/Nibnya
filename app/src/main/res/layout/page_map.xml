<?xml version="1.0" encoding="utf-8"?>
<!--
  「地图」页 —— 只读地形瓦片预览。

  设计要点（2026-11-02 立，2026-11-19 瓦片化后修订）：
    1. **不再单独选世界** —— 直接用主页当前打开的世界。
    2. **没有「生成地形」按钮** —— 进页面就加载，换世界自动重来。
    3. **范围 = 预加载半径** —— 不再是「图能画多大」，图没有边界。
    4. **开关要有明确的开/关外观** —— 旧版只靠文字颜色区分，
       在浅色主题下几乎看不出来（用户 2026-11-10 反馈过）。
       现在用 chip：开启时带底色 + 强调色文字，关闭时透明 + 次要色。

  布局：
    工具条：世界名 | 网格 chip | 半径 chip
    中间  ：MapView（左上角浮一层坐标/缩放读数）
    底部  ：状态行
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_map"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg"
    android:visibility="gone">

    <!-- ── 工具条 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/app_surface">

        <TextView
            android:id="@+id/tv_map_world"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_no_world"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <!-- 维度切换：主世界 / 下界 / 末地。点一下弹列表 -->
        <TextView
            android:id="@+id/tv_map_dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/map_dim_overworld"
            android:textColor="@color/app_text_primary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!--
          开关 chip。开启态由 MapPageController 用 background + textColor 切换，
          这里给的是关闭态默认值，避免首帧闪一下高亮。
        -->
        <TextView
            android:id="@+id/tv_map_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/map_grid_off"
            android:textColor="@color/app_text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 范围选择：点一下弹列表，不是循环切换 -->
        <TextView
            android:id="@+id/tv_map_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/map_radius_auto"
            android:textColor="@color/app_text_primary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_divider" />

    <!--
      ── 地形图 ──
      用 FrameLayout 是为了叠读数；MapView 吃满剩余高度。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <yhjmew.nibnya.map.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
          坐标 / 缩放读数。
          ⚠️ 不能设 clickable，否则会把拖动事件从 MapView 抢走。
        -->
        <TextView
            android:id="@+id/tv_map_readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="#B3141C26"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:clickable="false"
            android:focusable="false" />

        <!--
          空态覆盖层：没有打开世界时盖在地图上方，点一下就能选档。

          用 FrameLayout 铺满 + 半透明底，让「这里可以点」有明确区域，
          又不完全遮住深色底（用户能看到下面是地图页而不是白屏）。
        -->
        <LinearLayout
            android:id="@+id/layout_map_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="#F00E141B">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_empty_pick_world"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/map_empty_pick_hint"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!--
          状态气泡（替代原来固定在底部的整条状态栏）。

          用 FrameLayout 而不是横向 LinearLayout：
          wrap_content 让黑底只包住文字，短消息不会拉出一整条白/黑长条。
          gravity 由 MapPageController.applyStatusCorner() 按设置切换。
        -->
        <TextView
            android:id="@+id/tv_map_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:maxWidth="300dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_map_bubble"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />

    </FrameLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页下拉框「展开后的每一行」。

  系统自带的 simple_spinner_dropdown_item 是
  CheckedTextView + singleLine + ellipsize，长值（如「✎ 10000 秒」）
  在弹出列表里也会被截断。这里关掉省略，按文字宽度撑开，
  并保证每行至少 40dp 高度、方便点击。

  已知残留（不高优先级）：
  弹出列表本身宽度受 Spinner 宽度约束，极长的自定义值
  （6 位以上数字 + 单位）仍可能占满整行；
  必要时可改成多行显示，等有反馈再处理。
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="120dp"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:singleLine="true"
    android:ellipsize="none"
    android:textSize="15sp"
    android:textColor="@color/app_text_primary" />

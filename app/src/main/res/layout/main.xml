<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- ========================================= -->
    <!-- [层级 1] 主界面：内容区在上，底部导航栏固定在下 -->
    <!-- ========================================= -->
    <LinearLayout
        android:id="@+id/main_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
            <!-- ========================================= -->
            <!-- 页面容器：主页 / 地图 / 其他，三页叠放靠可见性切换 -->
            <!-- ========================================= -->
            <FrameLayout
                android:id="@+id/page_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- ===== 页面 1：主页（原 main_content） ===== -->
                <LinearLayout
                        android:id="@+id/page_home"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                <!-- 全屏模式下的顶栏 (功能齐全版) -->
                <LinearLayout
                    android:id="@+id/layout_fullscreen_bar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:background="@color/c_bar_top"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:gravity="center_vertical"
                    android:elevation="4dp">

                    <!-- 1. 返回 -->
                    <Button
                        android:id="@+id/btn_exit_fullscreen"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="←"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="#00000000"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:padding="0dp"
                        android:gravity="center" />

                    <!-- 2. 路径显示 -->
                    <TextView
                        android:id="@+id/tv_fullscreen_path"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/path"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:gravity="center_vertical|start"
                        android:paddingStart="4dp"
                        android:ellipsize="middle"
                        android:singleLine="true" />

                    <!-- === 右侧功能区 (紧凑排列) === -->

                    <!-- 3. 树状图切换 (绿) -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp">

                        <View
                            android:id="@+id/view_bg_fullscreen_tree"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_rounded_tint"
                            android:backgroundTint="@color/c_icon_tree_fs" />

                        <ImageButton
                            android:id="@+id/btn_fullscreen_tree"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tree_white" />
                    </FrameLayout>

                    <!-- 4. 显示设置 (橙) -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp">

                        <View
                            android:id="@+id/view_bg_fullscreen_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_rounded_tint"
                            android:backgroundTint="@color/c_icon_view_fs" />

                        <ImageButton
                            android:id="@+id/btn_fullscreen_view"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_eye_white" />
                    </FrameLayout>

                    <!-- 5. 搜索 (蓝) -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="0dp">

                        <View
                            android:id="@+id/view_bg_fullscreen_search"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_rounded_tint"
                            android:backgroundTint="@color/c_icon_search_fs" />

                        <ImageButton
                            android:id="@+id/btn_fullscreen_search"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_search_white" />
                    </FrameLayout>

                    <!-- 6. 菜单 (透明) -->
                    <Button
                        android:id="@+id/btn_fullscreen_menu"
                        android:layout_width="36dp"
                        android:layout_height="40dp"
                        android:text="⋮"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="#00000000"
                        android:textSize="22sp"
                        android:padding="0dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- 正常 UI (紧凑版) -->
                <LinearLayout
                    android:id="@+id/layout_normal_ui"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. 标题栏区域 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <!-- 减小底部间距 -->

                        <!-- [修改] 侧边栏触发按钮 (汉堡菜单) -->
                        <!-- 增加 elevation 确保浮在顶层 -->
                        <!-- 增加 clickable 和 focusable 属性 -->
                        <Button
                            android:id="@+id/btn_open_drawer"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:text="☰"
                            android:textAllCaps="false"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text_primary"
                            android:background="#00000000"
                            android:gravity="center"
                            android:padding="0dp"
                            android:layout_marginEnd="8dp"
                            android:elevation="10dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- 标题 -->
                        <!-- [修改] 动态标题区 (垂直布局：上面名字，下面种子) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <!-- 大标题：显示 APP名 或 存档名 -->
                            <TextView
                                android:id="@+id/tv_app_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/app_name"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/app_text_primary"
                                android:maxLines="3"
                                android:ellipsize="end" />

                            <!-- 种子：点一下直接复制纯数字（不靠长按选中，免得把 emoji 复制进去） -->
                            <TextView
                                android:id="@+id/tv_info_seed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/key_seed_placeholder"
                                android:textSize="10sp"
                                android:textColor="@color/app_text_secondary"
                                android:visibility="gone"
                                android:clickable="true"
                                android:focusable="false"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp" />
                        </LinearLayout>

                        <!-- 右侧按钮组 (更紧凑) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <!-- 第一行 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <Button
                                    android:id="@+id/btn_clear_cache"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:text="@string/btn_clean_cache"
                                    android:textAllCaps="false"
                                    android:textSize="11sp"
                                    android:backgroundTint="@color/c_btn_clear_cache"
                                    android:textColor="#FFFFFF"
                                    android:paddingTop="0dp"
                                    android:paddingBottom="0dp"
                                    android:layout_marginEnd="4dp" />
                            </LinearLayout>

                            <!-- 第二行 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="2dp">
                                <Button
                                    android:id="@+id/btn_switch_path"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:text="@string/btn_switch_path"
                                    android:textAllCaps="false"
                                    android:textSize="11sp"
                                    android:textColor="#FFFFFF"
                                    android:backgroundTint="@color/c_btn_switch_path"
                                    android:paddingTop="0dp"
                                    android:paddingBottom="0dp"
                                    android:layout_marginEnd="4dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 2. 存档选择框 (高度减小) -->
                    <EditText
                        android:id="@+id/et_world_name"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="@string/hint_select_world"
                        android:background="@color/app_surface"
                        android:padding="5dp"
                        android:gravity="center"
                        android:layout_marginBottom="6dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="14sp"
                        android:textIsSelectable="false"
                        android:longClickable="false"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:importantForAutofill="no" />

                    <!-- 3. 核心按钮矩阵 (高度减小，间距减小) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="4dp">

                        <!-- 第一行 加载/保存 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <Button
                                android:id="@+id/btn_copy"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:text="@string/btn_load"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:backgroundTint="@color/c_btn_copy"
                                android:textColor="#FFFFFF"
                                android:layout_marginEnd="4dp" />
                            <Button
                                android:id="@+id/btn_save"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:text="@string/btn_save"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:backgroundTint="@color/c_btn_save"
                                android:textColor="#FFFFFF"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <!-- 第二行 玩家/恢复 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button
                                android:id="@+id/btn_edit_player"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:text="@string/btn_edit_player"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:backgroundTint="@color/c_btn_edit_player"
                                android:textColor="#FFFFFF"
                                android:layout_marginEnd="4dp" />
                            <Button
                                android:id="@+id/btn_backup_history"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:text="@string/btn_restore"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:backgroundTint="@color/c_btn_backup"
                                android:textColor="#FFFFFF"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 4. 重新解析 (变扁) -->
                    <Button
                        android:id="@+id/btn_parse"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:text="@string/btn_reparse"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:backgroundTint="@color/c_btn_parse"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"
                        android:padding="0dp" />

                </LinearLayout>

                <!-- 3. 数据编辑标题栏 (工具栏) -->
                <LinearLayout
                    android:id="@+id/layout_editor_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="5dp"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/tv_current_path"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_editor"
                        android:textSize="12sp"
                        android:textColor="@color/app_text_secondary" />

                    <!-- [新增] 树状图模式 -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="5dp">

                        <View
                            android:id="@+id/view_bg_tree_mode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_rounded_tint"
                            android:backgroundTint="@color/c_icon_tree" />

                        <ImageButton
                            android:id="@+id/btn_tree_mode"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tree_white" />
                    </FrameLayout>

                    <!-- [新增] 显示选项 -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="5dp">

                        <View
                            android:id="@+id/view_bg_view_options"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_rounded_tint"
                            android:backgroundTint="@color/c_icon_view" />

                        <ImageButton
                            android:id="@+id/btn_view_options"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_eye_white" />
                    </FrameLayout>
                    <!-- === [新增] 搜索按钮 === -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="5dp">

                        <View
                            android:id="@+id/view_bg_search_nbt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_rounded_tint"
                            android:backgroundTint="@color/c_icon_search" />

                        <ImageButton
                            android:id="@+id/btn_search_nbt"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_search_white" />
                    </FrameLayout>
                    <!-- 进入全屏 -->
                    <Button
                        android:id="@+id/btn_go_fullscreen"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/btn_fullscreen"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/c_btn_fullscreen"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:padding="0dp" />
                </LinearLayout>

                <!-- 4. 主列表 -->
                <ListView
                    android:id="@+id/lv_nbt_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/app_surface"
                    android:divider="#EEEEEE"
                    android:dividerHeight="1dp"
                    android:padding="5dp"
                    android:layout_marginTop="5dp" />

                </LinearLayout>

                <!-- ===== 页面 2：地图（占位） ===== -->
                <include layout="@layout/page_map" />

                <!-- ===== 页面 3：其他（占位） ===== -->
                <include layout="@layout/page_more" />

            </FrameLayout>

            <!-- 底部导航栏（仿三键导航，纯文本） -->
            <include layout="@layout/bar_bottom_nav" />
    </LinearLayout>


<!-- 侧边栏容器：整屏铺满，内部叠放「侧边栏 + 遮罩」。
     ⚠️ 早期把侧边栏和遮罩当成横向并排的两个子 View，
        结果侧边栏被压成 78% 宽的一条、右边还多出一条灰边。 -->
<FrameLayout
    android:id="@+id/custom_sidebar_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- 侧边栏本体：宽度由代码设为屏幕的 78% -->
    <LinearLayout
        android:id="@+id/sidebar_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_surface"
        android:orientation="vertical"
        android:elevation="16dp">

        <!-- 【头部区域】固定高度，不滚动 -->
        <LinearLayout
            android:id="@+id/sidebar_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/c_bar_sidebar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <!-- 左侧：应用图标 -->
            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_launcher"
                android:scaleType="centerCrop"
                android:layout_marginEnd="12dp" />

            <!-- 右侧：名称区域 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sidebar_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sidebar_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/author_name"
                    android:textColor="#E8F5E9"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 【按钮列表】可滚动 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layout_sidebar_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <Button
                    android:id="@+id/btn_online_players"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_edit_online_players"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:backgroundTint="@color/c_btn_player"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_map_nbt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_edit_map_data"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/c_btn_map"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_village_nbt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_edit_village_data"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/c_btn_village"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_open_any_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_open_nbt_by_name_dvanced"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/c_btn_any_key"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_global_nbt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_global_system_data"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/c_btn_global"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!--
      遮罩：叠在侧边栏之上（FrameLayout 里后写的绘制在上层）。
      宽度由代码设为「屏幕宽 - 侧边栏宽」。
      ⚠️ 背景是全透明 —— 它只负责接收「点空白处关闭」的点击，
         不改变画面明暗（用户明确要求不要灰色蒙层）。
    -->
    <View
        android:id="@+id/view_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#00000000"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>

</FrameLayout>